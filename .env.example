# === Обязательные переменные ===

# Токен бота, который выдаёт @BotFather
BOT_TOKEN=

# === Необязательные переменные (у всех есть значения по умолчанию) ===

# Telegram ID владельца бота. Только он может использовать служебные команды
# (/setanket, /чс, /разблокировать). По умолчанию уже подставлен ID владельца.
OWNER_ID=7541580964

# Контакт для связи с администрацией, показывается в главном меню
ADMIN_CONTACT=@notrightuser

# Пригласительная ссылка, которая уходит пользователю при одобрении ОБЫЧНОЙ
# анкеты (не заявки на модератора). Замените на свою реальную ссылку —
# значение ниже лишь пример.
APPROVAL_INVITE_LINK=https://t.me/+93wjFvzLgdRjNDEy

# Баннер для команды /start.
# Можно указать либо file_id уже загруженной в Telegram картинки,
# либо прямую ссылку на изображение (https://...)
BANNER_IMAGE=

# GIF для раздела "Помощь в подаче анкеты".
# Можно указать либо file_id, либо прямую ссылку на gif/mp4
HELP_GIF=

# file_id стикеров из стикерпака https://t.me/addstickers/Akemi_Homura,
# по одному на каждый из 8 вопросов анкеты, через запятую, БЕЗ пробелов
# вокруг запятых. Порядок важен — 1-й file_id к 1-му вопросу и т.д.
# Как получить file_id: см. README.md, раздел "Как получить стикеры".
# Если оставить пустым — бот просто не будет отправлять стикеры к вопросам,
# всё остальное будет работать как обычно.
QUESTION_STICKERS=

# Через сколько дней после решения по анкете (одобрение/отказ)
# пользователь снова сможет подать анкету
COOLDOWN_DAYS=4

# Антиспам: сколько сообщений/нажатий разрешено за ANTISPAM_WINDOW_SECONDS
# секунд, прежде чем пользователь получит временную блокировку
ANTISPAM_LIMIT=6
ANTISPAM_WINDOW_SECONDS=8
ANTISPAM_BLOCK_MINUTES=15

# Папка для хранения JSON-файлов бота (не менять без необходимости)
DATA_DIR=data
